docker.enabled = true

params {
    reads  = null
    fasta  = null
    outdir = "${projectDir}/results"
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
}

process {
    withName: FASTQC {
        cpus = 12
    }
}

manifest {
    name = 'nf-human-variants'
    description = 'Nextflow DSL2 pipeline for human germline variant calling'
    version = '0.1.0'
}